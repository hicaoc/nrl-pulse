{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NRL互联",
  "identifier": "com.nrlptt.pttapp",
  "version": "0.2.9",
  "build": {
    "beforeBuildCommand": "VITE_MAS=1 npm run build"
  },
  "app": {
    "macOSPrivateApi": false
  },
  "plugins": {
    "updater": {
      "active": false
    }
  },
  "bundle": {
    "category": "Utility",
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "macOS": {
      "entitlements": "entitlements.mas.plist",
      "bundleVersion": "12"
    }
  }
}
